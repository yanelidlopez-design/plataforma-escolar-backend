# ============================================================
#  Plataforma Escolar — Backend (Django + DRF + SimpleJWT)
#  Archivo de ejemplo: copia este archivo como `.env` y ajusta
#  los valores reales. NUNCA subas el `.env` real a Git.
#  (`.env` ya está listado en .gitignore)
#
#  Formato: KEY=VALUE (sin espacios alrededor del `=`)
#  Variables leídas con django-environ en config/settings.py
# ============================================================

# ------------------------------------------------------------
# SEGURIDAD DE DJANGO
# ------------------------------------------------------------

# Clave secreta de Django: se usa para firmar cookies de sesión,
# tokens CSRF y demás. En producción debe ser una cadena larga
# e impredecible. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-por-una-clave-larga-y-secreta-generada-para-produccion

# Modo debug: 'True' muestra las páginas de error detalladas y
# desactiva varias medidas de seguridad. NUNCA uses True en
# producción (usa 'False').
DEBUG=True

# Lista de hosts permitidos (separados por coma) desde los que
# Django servirá la aplicación. Ej: localhost,127.0.0.1,mi-dominio.com
# En producción: en blanco bloquea todo; pon solo tus dominios reales.
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------
# El motor (ENGINE) se define en config/settings.py:
#   'django.db.backends.postgresql'  (PostgreSQL)
# Aquí solo se inyectan los datos de conexión.

DB_NAME=plataforma_escolar
DB_USER=postgres
DB_PASSWORD=cambiar-password-de-la-base
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------
# CORS (comunicación con el Frontend React)
# ------------------------------------------------------------

# Orígenes permitidos para peticiones desde el navegador
# (separados por coma). Debe coincidir exactamente con la URL
# del frontend, incluyendo protocolo y puerto.
# Ej: http://localhost:5173,https://tudominio.com
# Si el origen no está aquí, el navegador bloqueará la petición.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# WEBHOOK DE GOOGLE FORMS (protección HMAC / token)
# ------------------------------------------------------------

# Token secreto que el script de Google Apps Script debe enviar en
# la cabecera HTTP `X-Webhook-Token` al invocar
# /api/academico/webhook-google-forms/.
# La validación es "fail-closed": si esta variable está vacía o no
# coincide, el webhook responde 403 Forbidden. Genera uno con:
#   python -c "import secrets; print('whk-' + secrets.token_hex(16))"
WEBHOOK_SECRET_TOKEN=whk-pon-aqui-un-token-secreto-largo-y-aleatorio

# ------------------------------------------------------------
# AUTENTICACIÓN JWT (SimpleJWT) — configurado en config/settings.py
# ------------------------------------------------------------
# SimpleJWT lee sus parámetros de REST_FRAMEWORK["SIMPLE_JWT"] en
# settings, no del .env. Referencia de los valores usados:
#   POST /api/token/          -> obtiene access + refresh
#   POST /api/token/refresh/  -> renueva el access
#   Access token:  30 minutos de vida
#   Refresh token: 1 día de vida
# Los tokens se guardan en localStorage del frontend
# (access_token / refresh_token).
